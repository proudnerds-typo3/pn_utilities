	<file source-language="en" datatype="plaintext" original="EXT:pn_utilities/Resources/Private/Language/locallang.xlf" product-name="pn_utilities">
		<header/>
		<body>
			<trans-unit id="title" resname="title">
				<source>Pages not edited recently</source>
			</trans-unit>
			<trans-unit id="intro" resname="intro">
				<source>Standard pages on and below "%s" whose page properties and content have not changed in the chosen period.</source>
			</trans-unit>
			<trans-unit id="limitation" resname="limitation">
				<source>Records from storage folders, such as news, are not taken into account.</source>
			</trans-unit>
			<trans-unit id="error.noPageSelected" resname="error.noPageSelected">
				<source>Select a page in the page tree.</source>
			</trans-unit>
			<trans-unit id="days.label" resname="days.label">
				<source>Not edited for at least (days)</source>
			</trans-unit>
			<trans-unit id="submit" resname="submit">
				<source>Show</source>
			</trans-unit>
			<trans-unit id="column.pid" resname="column.pid">
				<source>Parent page ID</source>
			</trans-unit>
			<trans-unit id="column.uid" resname="column.uid">
				<source>Page ID</source>
			</trans-unit>
			<trans-unit id="column.language" resname="column.language">
				<source>Language ID</source>
			</trans-unit>
			<trans-unit id="column.lastChange" resname="column.lastChange">
				<source>Last change</source>
			</trans-unit>
			<trans-unit id="column.title" resname="column.title">
				<source>Page title</source>
			</trans-unit>
			<trans-unit id="column.actions" resname="column.actions">
				<source>Actions</source>
			</trans-unit>
			<trans-unit id="hidden" resname="hidden">
				<source>Hidden</source>
			</trans-unit>
			<trans-unit id="edit" resname="edit">
				<source>Edit page "%s"</source>
			</trans-unit>
			<trans-unit id="opensInNewTab" resname="opensInNewTab">
				<source>(opens in a new tab)</source>
			</trans-unit>
			<trans-unit id="total" resname="total">
				<source>%1$d pages not edited in %2$d days</source>
			</trans-unit>
			<trans-unit id="none" resname="none">
				<source>No pages found.</source>
			</trans-unit>
			<trans-unit id="pagination.label" resname="pagination.label">
				<source>Result pages</source>
			</trans-unit>
			<trans-unit id="pagination.first" resname="pagination.first">
				<source>First</source>
			</trans-unit>
			<trans-unit id="pagination.previous" resname="pagination.previous">
				<source>Previous</source>
			</trans-unit>
			<trans-unit id="pagination.next" resname="pagination.next">
				<source>Next</source>
			</trans-unit>
			<trans-unit id="pagination.last" resname="pagination.last">
				<source>Last</source>
			</trans-unit>
			<trans-unit id="pagination.status" resname="pagination.status">
				<source>Page %1$d of %2$d, rows %3$d–%4$d</source>
			</trans-unit>
			<trans-unit id="users.title" resname="users.title">
				<source>Backend users</source>
			</trans-unit>
			<trans-unit id="users.intro" resname="users.intro">
				<source>Create and manage backend users. You only see users whose groups are all marked as assignable by an administrator, and who have no permissions of their own on top of their groups.</source>
			</trans-unit>
			<trans-unit id="users.passwordResetDisabled" resname="users.passwordResetDisabled">
				<source>Password reset by email is switched off in this installation ([BE][passwordReset]). New users cannot set a password until an administrator switches it on.</source>
			</trans-unit>
			<trans-unit id="users.noAssignableGroups" resname="users.noAssignableGroups">
				<source>No group is marked as assignable yet. An administrator can do this in the group record, with "Assignable in user management".</source>
			</trans-unit>
			<trans-unit id="users.new" resname="users.new">
				<source>New user</source>
			</trans-unit>
			<trans-unit id="users.new.intro" resname="users.new.intro">
				<source>The new user receives an email with a link to set a password. The link is valid for two hours.</source>
			</trans-unit>
			<trans-unit id="users.none" resname="users.none">
				<source>No users found.</source>
			</trans-unit>
			<trans-unit id="users.field.username" resname="users.field.username">
				<source>Username</source>
			</trans-unit>
			<trans-unit id="users.field.username.help" resname="users.field.username.help">
				<source>Lowercase, no spaces. Cannot be changed later.</source>
			</trans-unit>
			<trans-unit id="users.field.username.readonly" resname="users.field.username.readonly">
				<source>The username cannot be changed.</source>
			</trans-unit>
			<trans-unit id="users.field.realName" resname="users.field.realName">
				<source>Name</source>
			</trans-unit>
			<trans-unit id="users.field.email" resname="users.field.email">
				<source>Email address</source>
			</trans-unit>
			<trans-unit id="users.field.email.readonly" resname="users.field.email.readonly">
				<source>The email address cannot be changed here. Ask an administrator.</source>
			</trans-unit>
			<trans-unit id="users.field.email.help" resname="users.field.email.help">
				<source>The link to set a password is sent to this address. Each address can be used by one user only.</source>
			</trans-unit>
			<trans-unit id="users.field.groups" resname="users.field.groups">
				<source>Groups</source>
			</trans-unit>
			<trans-unit id="users.field.groups.help" resname="users.field.groups.help">
				<source>The user gets the rights of every group selected here.</source>
			</trans-unit>
			<trans-unit id="users.column.lastLogin" resname="users.column.lastLogin">
				<source>Last login</source>
			</trans-unit>
			<trans-unit id="users.column.actions" resname="users.column.actions">
				<source>Actions</source>
			</trans-unit>
			<trans-unit id="users.neverLoggedIn" resname="users.neverLoggedIn">
				<source>Never</source>
			</trans-unit>
			<trans-unit id="users.disabled" resname="users.disabled">
				<source>Disabled</source>
			</trans-unit>
			<trans-unit id="users.edit" resname="users.edit">
				<source>Edit %s</source>
			</trans-unit>
			<trans-unit id="users.enable" resname="users.enable">
				<source>Enable %s</source>
			</trans-unit>
			<trans-unit id="users.disable" resname="users.disable">
				<source>Disable %s</source>
			</trans-unit>
			<trans-unit id="users.sendPasswordReset" resname="users.sendPasswordReset">
				<source>Send %s a link to set a new password</source>
			</trans-unit>
			<trans-unit id="users.delete" resname="users.delete">
				<source>Delete %s</source>
			</trans-unit>
			<trans-unit id="users.delete.confirm" resname="users.delete.confirm">
				<source>Delete user "%s"? The user can no longer log in. An administrator can restore the account.</source>
			</trans-unit>
			<trans-unit id="users.delete.ok" resname="users.delete.ok">
				<source>Delete</source>
			</trans-unit>
			<trans-unit id="users.save" resname="users.save">
				<source>Save</source>
			</trans-unit>
			<trans-unit id="users.cancel" resname="users.cancel">
				<source>Cancel</source>
			</trans-unit>
			<trans-unit id="users.error.summary" resname="users.error.summary">
				<source>The user was not saved. Correct the following:</source>
			</trans-unit>
			<trans-unit id="users.error.username.required" resname="users.error.username.required">
				<source>Enter a username.</source>
			</trans-unit>
			<trans-unit id="users.error.username.invalid" resname="users.error.username.invalid">
				<source>The username may not contain spaces or start with an underscore.</source>
			</trans-unit>
			<trans-unit id="users.error.username.tooLong" resname="users.error.username.tooLong">
				<source>The username may be at most 50 characters long.</source>
			</trans-unit>
			<trans-unit id="users.error.username.taken" resname="users.error.username.taken">
				<source>This username is already in use. Choose another one.</source>
			</trans-unit>
			<trans-unit id="users.error.realName.tooLong" resname="users.error.realName.tooLong">
				<source>The name may be at most 80 characters long.</source>
			</trans-unit>
			<trans-unit id="users.error.email.required" resname="users.error.email.required">
				<source>Enter an email address.</source>
			</trans-unit>
			<trans-unit id="users.error.email.invalid" resname="users.error.email.invalid">
				<source>Enter a valid email address, such as name@example.com.</source>
			</trans-unit>
			<trans-unit id="users.error.email.taken" resname="users.error.email.taken">
				<source>This email address already belongs to another user. Use a different address.</source>
			</trans-unit>
			<trans-unit id="users.error.groups.required" resname="users.error.groups.required">
				<source>Select at least one group.</source>
			</trans-unit>
			<trans-unit id="users.error.groups.invalid" resname="users.error.groups.invalid">
				<source>One of the selected groups cannot be assigned. Reload the page and try again.</source>
			</trans-unit>
			<trans-unit id="users.message.created" resname="users.message.created">
				<source>User "%s" was created.</source>
			</trans-unit>
			<trans-unit id="users.message.updated" resname="users.message.updated">
				<source>User "%s" was saved.</source>
			</trans-unit>
			<trans-unit id="users.message.disabled" resname="users.message.disabled">
				<source>User "%s" was disabled and can no longer log in.</source>
			</trans-unit>
			<trans-unit id="users.message.enabled" resname="users.message.enabled">
				<source>User "%s" was enabled.</source>
			</trans-unit>
			<trans-unit id="users.message.deleted" resname="users.message.deleted">
				<source>User "%s" was deleted.</source>
			</trans-unit>
			<trans-unit id="users.message.resetSent" resname="users.message.resetSent">
				<source>An email with a link to set a password was requested for %s.</source>
			</trans-unit>
			<trans-unit id="users.message.resetUnavailable" resname="users.message.resetUnavailable">
				<source>No email was sent to %s: password reset is switched off, or the user is disabled.</source>
			</trans-unit>
			<trans-unit id="users.message.notFound" resname="users.message.notFound">
				<source>This user does not exist or you may not manage it.</source>
			</trans-unit>
		</body>
	</file>
